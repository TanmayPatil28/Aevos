generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions"), vector]
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?          @map("email_verified")
  image             String?
  password          String?
  university        String             @default("jspm")
  isOnboarded       Boolean            @default(false) @map("is_onboarded")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at")
  activeSnapshotId  String?            @map("active_snapshot_id")
  academicSnapshots AcademicSnapshot[]
  accounts          Account[]
  calculations      Calculation[]
  documents         Document[]
  enrollments       Enrollment[]
  plans             Plan[]
  sessions          Session[]
  skillProgress     SkillProgress[]
  interviewSessions InterviewSession[]
  memories          UserMemory[]
  chatMemories      ChatMemory[]
  careerProfile     CareerProfile?
  dynamicRoadmaps   DynamicRoadmap[]
  backlogRecords    BacklogRecord[]
  physicsProfile    UserPhysicsProfile?

  @@index([activeSnapshotId])
  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Calculation {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  semester      String
  subjects      Json
  sgpa          Float
  cgpa          Float
  total_credits Int
  created_at    DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("calculations")
}

model Plan {
  id                  String   @id @default(cuid())
  current_cgpa        Float
  target_cgpa         Float
  completed_semesters Int
  remaining_semesters Int
  required_gpa        Float
  plan_data           Json
  current_semester    String?
  created_at          DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")
  userId              String   @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("plans")
}

model Course {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  credits     Int
  prereqs     String[]
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at")
  enrollments    Enrollment[]
  timetableSlots TimetableSlot[]
  backlogRecords BacklogRecord[]

  @@map("courses")
}

model Enrollment {
  id               String          @id @default(cuid())
  userId           String          @map("user_id")
  courseId         String          @map("course_id")
  semester         String
  grade            String?
  cieMarks         Float           @default(0) @map("cie_marks")
  seeMarks         Float?          @map("see_marks")
  attendanceTotal  Int             @default(0) @map("attendance_total")
  attendanceBunked Int             @default(0) @map("attendance_bunked")
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at")
  attendanceLogs   AttendanceLog[]
  course           Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model AttendanceLog {
  id           String           @id @default(cuid())
  enrollmentId String           @map("enrollment_id")
  date         DateTime         @default(now()) @map("date")
  status       AttendanceStatus
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at")
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@map("attendance_logs")
}

model AcademicSnapshot {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  createdAt            DateTime @default(now()) @map("created_at")
  sourceType           String   @map("source_type")
  sourceInstitution    String   @map("source_institution")
  snapshotType         String   @map("snapshot_type")
  parserVersion        String   @map("parser_version")
  regulationVersion    String   @map("regulation_version")
  normalizationVersion String   @map("normalization_version")
  schemaVersion        String   @default("1.0") @map("schema_version")
  confidenceScore      Float    @map("confidence_score")
  checksumHash         String   @map("checksum_hash")
  verificationStatus   String   @default("unverified") @map("verification_status")
  academicProfile      Json     @map("academic_profile")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("academic_snapshots")
}

model SkillProgress {
  id          String              @id @default(cuid())
  userId      String              @map("user_id")
  roadmapId   String              @map("roadmap_id")
  nodeId      String              @map("node_id")
  status      String              @default("in_progress")
  completedAt DateTime?           @map("completed_at")
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at")
  milestones  MilestoneProgress[]
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapId, nodeId])
  @@index([userId])
  @@map("skill_progress")
}

model MilestoneProgress {
  id              String        @id @default(cuid())
  skillProgressId String        @map("skill_progress_id")
  milestoneId     String        @map("milestone_id")
  completed       Boolean       @default(false)
  completedAt     DateTime?     @map("completed_at")
  skillProgress   SkillProgress @relation(fields: [skillProgressId], references: [id], onDelete: Cascade)

  @@unique([skillProgressId, milestoneId])
  @@index([skillProgressId])
  @@map("milestone_progress")
}

model UserMemory {
  id         String                @id @default(cuid())
  userId     String                @map("user_id")
  documentId String?               @map("document_id")
  content    String
  embedding  Unsupported("vector")
  createdAt  DateTime              @default(now()) @map("created_at")
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   Document?             @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentId])
  @@map("user_memories")
}

model Document {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  fileName  String       @map("file_name")
  fileUrl   String       @map("file_url")
  fileType  String       @map("file_type")
  tags      String[]     @default([])
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  memories  UserMemory[]

  @@index([userId])
  @@map("documents")
}

model ChatMemory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  sessionId String   @map("session_id")
  role      String
  content   String
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sessionId, createdAt(sort: Desc)])
  @@map("chat_memory")
}

model CareerProfile {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  resumeText    String
  skills        String[]
  projects      Json
  atsScore      Int
  actionPlan    Json
  detailedAudit Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("career_profiles")
}

model InterviewSession {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  targetRole  String
  transcript  Json     @default("[]")
  finalScore  Int?
  feedback    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("interview_sessions")
}

model DynamicRoadmap {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  targetRole  String
  targetJd    String
  nodes       Json     @default("[]")
  edges       Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("dynamic_roadmaps")
}

enum BacklogStatus {
  PENDING
  REGISTERED
  EXAM_SCHEDULED
  CLEARED
  VOIDED
}

model AcademicCalendarEvent {
  id           String   @id @default(cuid())
  university   String   @default("jspm")
  title        String
  description  String?
  eventType    String   @map("event_type")
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  academicYear String   @map("academic_year")
  semester     String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([university])
  @@index([startDate, endDate])
  @@map("academic_calendar_events")
}

model TimetableSlot {
  id           String   @id @default(cuid())
  courseId     String   @map("course_id")
  dayOfWeek    Int      @map("day_of_week")
  startTime    String   @map("start_time")
  endTime      String   @map("end_time")
  room         String
  instructor   String?
  section      String?
  semester     String
  academicYear String   @map("academic_year")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([dayOfWeek])
  @@map("timetable_slots")
}

model BacklogRecord {
  id               String        @id @default(cuid())
  userId           String        @map("user_id")
  courseId         String        @map("course_id")
  originalSemester String        @map("original_semester")
  originalGrade    String        @map("original_grade")
  status           BacklogStatus @default(PENDING)
  attemptsCount    Int           @default(0) @map("attempts_count")
  nextExamDate     DateTime?     @map("next_exam_date")
  recoveryPathway  String?       @map("recovery_pathway")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at")

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("backlog_records")
}

model ATKTRule {
  id                   String   @id @default(cuid())
  university           String   @unique
  maxBacklogsAllowed   Int      @map("max_backlogs_allowed")
  recoveryWindowMonths Int      @map("recovery_window_months")
  allowSummerTerm      Boolean  @default(true) @map("allow_summer_term")
  minGpaToRecover      Float    @map("min_gpa_to_recover")
  description          String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("atkt_rules")
}

model Feedback {
  id        String   @id @default(cuid())
  rating    Int
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("feedback")
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  @@map("waitlist")
}

model UserPhysicsProfile {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  circadianRhythm   String   @default("neutral")
  baselineFatigue   Float    @default(0.0)
  sleepDebt         Float    @default(0.0)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_physics_profiles")
}
