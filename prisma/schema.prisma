generator client {
  provider   = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?
  university    String    @default("jspm")
  accounts      Account[]
  sessions      Session[]
  calculations  Calculation[]
  plans         Plan[]
  enrollments       Enrollment[]
  academicSnapshots AcademicSnapshot[]
  activeSnapshotId  String?            @map("active_snapshot_id")
  createdAt         DateTime           @default(now())

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Calculation {
  id            Int      @id @default(autoincrement())
  date          DateTime @default(now())
  semester      String
  subjects      Json
  sgpa          Float
  cgpa          Float
  total_credits Int
  created_at    DateTime @default(now())

  userId        String?  @map("user_id")
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calculations")
}

model Plan {
  id                  Int      @id @default(autoincrement())
  current_cgpa        Float
  target_cgpa         Float
  completed_semesters Int
  remaining_semesters Int
  required_gpa        Float
  plan_data           Json
  current_semester    String? // Made optional for backward compatibility
  created_at          DateTime @default(now())

  userId              String?  @map("user_id")
  user                User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("plans")
}

model Course {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  credits     Int
  prereqs     String[]     // Array of course codes that are prerequisites
  enrollments Enrollment[]

  @@map("courses")
}

model Enrollment {
  id               String          @id @default(cuid())
  userId           String          @map("user_id")
  courseId         String          @map("course_id")
  semester         String
  grade            String?
  cieMarks         Float           @default(0) @map("cie_marks")
  seeMarks         Float?          @map("see_marks")
  attendanceTotal  Int             @default(0) @map("attendance_total")
  attendanceBunked Int             @default(0) @map("attendance_bunked")
  
  attendanceLogs   AttendanceLog[]
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model AttendanceLog {
  id           String     @id @default(cuid())
  enrollmentId String     @map("enrollment_id")
  date         DateTime   @map("date") @default(now())
  status       String     // "PRESENT", "ABSENT", "CANCELLED"
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("attendance_logs")
}

model AcademicSnapshot {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  createdAt            DateTime @default(now()) @map("created_at")
  
  // Provenance & Versioning Engine
  sourceType           String   @map("source_type") // e.g., 'digicampus', 'ocr', 'manual'
  sourceInstitution    String   @map("source_institution") // e.g., 'jspm', 'sppu'
  snapshotType         String   @map("snapshot_type") // e.g., 'official_import', 'manual_entry', 'simulation', 'migration', 'recovery'
  parserVersion        String   @map("parser_version")
  regulationVersion    String   @map("regulation_version")
  normalizationVersion String   @map("normalization_version")
  schemaVersion        String   @default("1.0") @map("schema_version")
  
  // Integrity & Trust Metadata
  confidenceScore      Float    @map("confidence_score")
  checksumHash         String   @map("checksum_hash")
  verificationStatus   String   @default("unverified") @map("verification_status") // verified, unverified, partial, conflicted, corrupted
  
  // The Immutable Academic State Payload
  academicProfile      Json     @map("academic_profile")

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("academic_snapshots")
}
