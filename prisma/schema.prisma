generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?          @map("email_verified")
  image             String?
  password          String?
  university        String             @default("jspm")
  createdAt         DateTime           @default(now())
  activeSnapshotId  String?            @map("active_snapshot_id")
  academicSnapshots AcademicSnapshot[]
  accounts          Account[]
  calculations      Calculation[]
  enrollments       Enrollment[]
  plans             Plan[]
  sessions          Session[]
  skillProgress     SkillProgress[]
  memories          UserMemory[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Calculation {
  id            Int      @id @default(autoincrement())
  date          DateTime @default(now())
  semester      String
  subjects      Json
  sgpa          Float
  cgpa          Float
  total_credits Int
  created_at    DateTime @default(now())
  userId        String?  @map("user_id")
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calculations")
}

model Plan {
  id                  Int      @id @default(autoincrement())
  current_cgpa        Float
  target_cgpa         Float
  completed_semesters Int
  remaining_semesters Int
  required_gpa        Float
  plan_data           Json
  current_semester    String?
  created_at          DateTime @default(now())
  userId              String?  @map("user_id")
  user                User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("plans")
}

model Course {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  credits     Int
  prereqs     String[]
  enrollments Enrollment[]

  @@map("courses")
}

model Enrollment {
  id               String          @id @default(cuid())
  userId           String          @map("user_id")
  courseId         String          @map("course_id")
  semester         String
  grade            String?
  cieMarks         Float           @default(0) @map("cie_marks")
  seeMarks         Float?          @map("see_marks")
  attendanceTotal  Int             @default(0) @map("attendance_total")
  attendanceBunked Int             @default(0) @map("attendance_bunked")
  attendanceLogs   AttendanceLog[]
  course           Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model AttendanceLog {
  id           String     @id @default(cuid())
  enrollmentId String     @map("enrollment_id")
  date         DateTime   @default(now()) @map("date")
  status       String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("attendance_logs")
}

model AcademicSnapshot {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  createdAt            DateTime @default(now()) @map("created_at")
  sourceType           String   @map("source_type")
  sourceInstitution    String   @map("source_institution")
  snapshotType         String   @map("snapshot_type")
  parserVersion        String   @map("parser_version")
  regulationVersion    String   @map("regulation_version")
  normalizationVersion String   @map("normalization_version")
  schemaVersion        String   @default("1.0") @map("schema_version")
  confidenceScore      Float    @map("confidence_score")
  checksumHash         String   @map("checksum_hash")
  verificationStatus   String   @default("unverified") @map("verification_status")
  academicProfile      Json     @map("academic_profile")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("academic_snapshots")
}

model SkillProgress {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  roadmapId   String    @map("roadmap_id") 
  nodeId      String    @map("node_id")    
  status      String    @default("in_progress")
  completedAt DateTime? @map("completed_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones  MilestoneProgress[]

  @@unique([userId, roadmapId, nodeId])
  @@map("skill_progress")
}

model MilestoneProgress {
  id              String        @id @default(cuid())
  skillProgressId String        @map("skill_progress_id")
  milestoneId     String        @map("milestone_id")
  completed       Boolean       @default(false)
  completedAt     DateTime?     @map("completed_at")
  skillProgress   SkillProgress @relation(fields: [skillProgressId], references: [id], onDelete: Cascade)

  @@unique([skillProgressId, milestoneId])
  @@map("milestone_progress")
}

model UserMemory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  content   String
  embedding Unsupported("vector(768)")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_memories")
}
