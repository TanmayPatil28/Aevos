# .env.example

# Database
# Provide your Postgres connection string (e.g., via Neon)
DATABASE_URL="postgres://user:password@host:port/gradeflow"

# NextAuth
# Generate a secure secret (e.g., using `openssl rand -base64 32`)
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# Optional external API keys can be documented here
